# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Local environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Accepted datasets, manifests, checkpoints, logs, databases, evidence captures,
# notebook exports, reports and presentations are project artifacts and are
# intentionally tracked so a fresh clone contains the complete project.

# Operating-system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Keep the reusable build helpers, but never publish transient browser profiles
# or other files that may later be created under tmp/.
tmp/*
!tmp/execute_notebook.py
!tmp/pdfs/
tmp/pdfs/*
!tmp/pdfs/build_reconnaissance_pdf.py

# Books warm-up: keep private datasets, backups, request logs and temporary
# files local while allowing source code and validation summaries to be tracked.
warmup_books/**/*.csv
warmup_books/backups/
warmup_books/.venv/
warmup_books/__pycache__/
warmup_books/**/*_backup.*
warmup_books/**/daily_request_usage*.json
warmup_books/**/*.tmp
warmup_books/**/*.temp
warmup_books/**/*.bak
warmup_books/**/*.log

