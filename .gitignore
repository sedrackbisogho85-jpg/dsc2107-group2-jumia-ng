# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Local environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Generated collection data and databases stay local unless the group approves
# a separate evidence-publication task. These rules protect new run artifacts;
# files from earlier runs that are already tracked remain tracked by Git.
data/raw/*.csv
data/raw/*.json
data/cleaned/*.csv
data/checkpoints/*.json
logs/*.log
database/*.sqlite

# Operating-system and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Keep the reusable build helpers, but never publish transient browser profiles
# or other files that may later be created under tmp/.
tmp/*
!tmp/execute_notebook.py
!tmp/pdfs/
tmp/pdfs/*
!tmp/pdfs/build_reconnaissance_pdf.py

# Local recovery copies
BACKUPS/
